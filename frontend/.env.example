# ==============================================================================
# SISTEM PEMANTAUAN PENDAPATAN & TK PEGAWAI BPS (HALOPAY)
# TEMPLATE VARIABEL LINGKUNGAN FRONTEND (.env.example)
#
# Petunjuk Penggunaan:
# Salin file ini menjadi .env.local untuk lingkungan pengembangan lokal:
# cp .env.example .env.local
# (Catatan: Frontend tidak memerlukan JWT_SECRET atau kredensial database;
#  seluruh data dan autentikasi ditangani oleh Backend FastAPI).
# ==============================================================================

# 1. URL Aplikasi Frontend (Digunakan untuk SSO Keycloak Callback)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Keycloak SSO / OIDC Configuration
KEYCLOAK_URL=https://auth_your_keycloak_url_here
KEYCLOAK_REALM=your_keycloak_realm_here
KEYCLOAK_CLIENT_ID=your_keycloak_client_id_here

# 3. Backend FastAPI Internal Proxy URL (Default: http://127.0.0.1:8000; Dalam Docker: http://backend:8000)
FASTAPI_INTERNAL_URL=http://127.0.0.1:8000
