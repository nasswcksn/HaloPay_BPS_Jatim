# Backend Configuration Template (HaloPay BPS Jatim)
PROJECT_NAME="HaloPay BPS Jatim Backend"
API_V1_STR="/api/v1"

# PostgreSQL Database (On-Premise Docker: gunakan host 'db'; Lokal: gunakan 'localhost')
DATABASE_URL=postgresql://your_db_user:your_secure_password@db:5432/halopay_db



# Keycloak SSO OIDC Configuration
KEYCLOAK_URL=your_keycloak_url_here
KEYCLOAK_REALM=your_keycloak_realm_here
KEYCLOAK_CLIENT_ID=your_keycloak_client_id_here

# JWT Secret Sesi HaloPay
JWT_SECRET=your_super_secure_random_jwt_secret_key_here

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
