# ==============================================================================
# SISTEM PEMANTAUAN PENDAPATAN & TK PEGAWAI BPS JATIM (HALOPAY)
# MASTER ENVIRONMENT TEMPLATE (.env.example)
#
# Petunjuk Penggunaan:
# 1. Salin file ini menjadi .env di root direktori proyek:
#    cp .env.example .env
# 2. Isi nilai kredensial dengan password dan secret yang aman.
# 3. Berkas .env tidak akan pernah ter-commit ke Git (.gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database PostgreSQL On-Premise (Container halopay-db)
# ------------------------------------------------------------------------------
POSTGRES_USER=halopay_user
POSTGRES_PASSWORD=ganti_dengan_password_database_rahasia_dan_kuat_2026
POSTGRES_DB=halopay_db

# ------------------------------------------------------------------------------
# 2. Kunci Rahasia Sesi (JWT Secret - Hanya diakses oleh Backend FastAPI)
# ------------------------------------------------------------------------------
# Generate string acak kuat (min. 32 karakter), misal: openssl rand -base64 32
JWT_SECRET=ganti_dengan_jwt_secret_rahasia_panjang_minimal_32_karakter_2026

# ------------------------------------------------------------------------------
# 3. Integrasi SSO Keycloak BPS (OIDC)
# ------------------------------------------------------------------------------
KEYCLOAK_URL=https://auth.majapah.it
KEYCLOAK_REALM=majapahit
KEYCLOAK_CLIENT_ID=halopay

# ------------------------------------------------------------------------------
# 4. Port & URL Akses Jaringan Host Server
# ------------------------------------------------------------------------------
FRONTEND_PORT=3005
BACKEND_PORT=8005
DB_PORT=5432
NEXT_PUBLIC_APP_URL=http://localhost:3005
